# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Per-environment tfvars ARE committed. They are the definition of each
# environment and carry no secrets — the database password is generated by
# Terraform, and AWS credentials come from the environment.
*.auto.tfvars
!*.auto.tfvars.example
!terraform/environments/*/terraform.tfvars

# Kubeconfig written by `make kubeconfig`
kubeconfig
kubeconfig-*

# Go
bin/
dist/
*.test
*.out

# Local environment
.env
.env.local

# Editors / OS / tooling
.idea/
.vscode/
.DS_Store

# Local tool config, not project configuration
.claude/
